# Choose: groq | gemini | openrouter
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# API keys: set only the providers you plan to use
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional model overrides
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=openai/gpt-4o-mini

# RAG configuration
POLICY_DIR=data/policies
CHROMA_DIR=storage/chroma
CHROMA_COLLECTION=nexora_policy_chunks
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=75
DENSE_CANDIDATES=12
BM25_CANDIDATES=12
RERANK_CANDIDATES=10
TOP_K=4
RRF_K=60

# LLM routing: when true, try configured fallback providers in order
ENABLE_LLM_FALLBACK=false
LLM_FALLBACK_ORDER=groq,openrouter,gemini
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1200

# Demo marker; keep true for the synthetic Nexora documents
DEMO_MODE=true
