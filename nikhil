def run_eda_and_feature_engineering():
    print("=== Step 1: Loading Enhanced Dataset ===")
    df = pd.read_csv('enhanced_customer_banking_dataset.csv')
    print(f"Dataset loaded successfully with shape: {df.shape[0]} rows, {df.shape[1]} columns\n")

    print("=== Step 2: Exploratory Data Analysis (EDA) ===")
    # Basic dataset info
    print("Data Types & Missing Values Check:")
    print(df.isnull().sum()[df.isnull().sum() > 0]) # Should be empty
    print(f"\nTotal duplicate rows: {df.duplicated().sum()}")

    # Summary statistics for key financial columns
    key_cols = ['LIMIT_BAL', 'AGE', 'BILL_AMT1', 'PAY_AMT1']
    print("\nSummary Statistics of Key Numerical Columns:")
    print(df[key_cols].describe())

    # Segment distribution (FR-02 requirement)
    print("\nCustomer Segment Breakdown:")
    segment_counts = df['customer_segment'].value_counts()
    for segment, count in segment_counts.items():
        print(f" - {segment}: {count} customers ({count/len(df)*100:.2f}%)")

    print("\n=== Step 3: Feature Engineering ===")
    # 1. Credit Utilization Ratio (Latest bill amount relative to credit limit)
    df['credit_utilization'] = df['BILL_AMT1'] / df['LIMIT_BAL']
    df['credit_utilization'] = df['credit_utilization'].clip(lower=0.0, upper=2.0)

    # 2. Payment Trend (Difference between recent payment delay PAY_0 and older delay PAY_6)
    # Positive values indicate deteriorating payment discipline over 6 months
    df['payment_trend'] = df['PAY_0'] - df['PAY_6']

    # 3. Total Repayment Volume (Sum of payments over the last 6 months)
    payment_cols = ['PAY_AMT1', 'PAY_AMT2', 'PAY_AMT3', 'PAY_AMT4', 'PAY_AMT5', 'PAY_AMT6']
    df['total_repayment'] = df[payment_cols].sum(axis=1)

    # 4. Average Bill Amount (Mean billing scale across 6 months)
    bill_cols = ['BILL_AMT1', 'BILL_AMT2', 'BILL_AMT3', 'BILL_AMT4', 'BILL_AMT5', 'BILL_AMT6']
    df['avg_bill_amount'] = df[bill_cols].mean(axis=1)

    print("New Engineered Features Added:")
    print(" 1. credit_utilization")
    print(" 2. payment_trend")
    print(" 3. total_repayment")
    print(" 4. avg_bill_amount")

    print("\n=== Step 4: Saving Engineered Dataset ===")
    output_filename = 'engineered_customer_banking_dataset.csv'
    df.to_csv(output_filename, index=False)
    print(f"Engineered dataset successfully saved to '{output_filename}'")
    print(f"Final Dataset Shape: {df.shape}")

if __name__ == "__main__":
    run_eda_and_feature_engineering()


