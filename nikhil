# FR-03: Policy-Based Strategy Selection

POLICY_RULES = {
    'Loyalty Candidate': {
        'objective': 'Appreciation & Premium Reward',
        'tone': 'Warm, exclusive, and appreciative',
        'template_type': 'loyalty_reward_email'
    },
    'Consistent': {
        'objective': 'Engagement & Milestone Recognition',
        'tone': 'Encouraging, polite, and steady',
        'template_type': 'consistent_appreciation_email'
    },
    'Dormant / Low Activity': {
        'objective': 'Re-engagement & Activation Offer',
        'tone': 'Inviting, helpful, and low-pressure',
        'template_type': 'reengagement_email'
    },
    'Declining Activity': {
        'objective': 'Retention & Feedback Incentive',
        'tone': 'Supportive and attentive',
        'template_type': 'retention_email'
    },
    'Payment Reminder / Overdue': {
        'objective': 'Courteous or Progressive Bill Reminder',
        'tone': 'Professional, respectful, and firm with a clear support/dispute path',
        'template_type': 'billing_reminder_email'
    }
}

# FR-05: Offer & Reward Controls Validation

def validate_offer(customer_row):
    """
    Validates eligibility, offer identifiers, terms, expiry, and consent
    before an offer or reward is included in the message.
    """
    offer_id = customer_row['approved_offer_id']
    expiry_date = customer_row['offer_expiry_date']
    consent = customer_row['consent_given']
    
    # Safety Check: Consent Verification (FR-07 / FR-05)
    if not consent:
        return {"valid": False, "reason": "Blocked: Customer communication consent is False."}
    
    # Expiry Check
    today = datetime.date.today().strftime('%Y-%m-%d')
    if expiry_date < today:
        return {"valid": False, "reason": f"Blocked: Offer {offer_id} expired on {expiry_date}."}
        
    return {"valid": True, "offer_id": offer_id, "expiry": expiry_date}

# ==========================================
# FR-04: Grounded Message Generation (Prompt Constructor)
# ==========================================
def generate_grounded_prompt(customer_id):
    """
    Constructs a strict LLM prompt using ONLY verified customer facts, 
    approved offer details, and reusable policy-controlled content.
    """
    customer = df[df['ID'] == customer_id].iloc[0]
    segment = customer['customer_segment']
    policy = POLICY_RULES.get(segment, {})
    
    # Step 1: Run deterministic offer/compliance validation (FR-05 & FR-07)
    offer_validation = validate_offer(customer)
    if not offer_validation['valid']:
        return {
            "status": "REFUSED / BLOCKED",
            "reason": offer_validation['reason'],
            "prompt": None
        }
    
    # Step 2: Build grounded LLM prompt with strict fact boundaries
    prompt = f"""
You are an AI Customer Engagement Assistant for a retail bank.
Draft an email subject and body for the customer below using ONLY the verified facts provided. 
Do NOT invent amounts, dates, interest rates, or unauthorized perks.

--- VERIFIED CUSTOMER PROFILE & EVIDENCE ---
- Customer ID: {customer['ID']}
- Assigned Segment: {segment}
- Credit Limit: ₹{customer['LIMIT_BAL']:,.2f}
- Latest Statement Bill (Bill Amt 1): ₹{customer['BILL_AMT1']:,.2f}
- Credit Utilization: {customer['credit_utilization']*100:.1f}%
- Total 6-Month Repayment: ₹{customer['total_repayment']:,.2f}
- Preferred Contact Channel: {customer['preferred_channel']}
- Approved Offer / Reward ID: {offer_validation['offer_id']} (Valid till: {offer_validation['expiry']})

--- POLICY & STRATEGY RULES ---
- Objective: {policy.get('objective')}
- Tone: {policy.get('tone')}
- Template Type: {policy.get('template_type')}

Draft the email clearly, maintain professional boundaries, and ensure all financial figures match the verified evidence exactly.
"""
    return {
        "status": "APPROVED FOR GENERATION",
        "reason": "All policy, consent, and eligibility checks passed successfully.",
        "prompt": prompt.strip()
    }

